# Copy this file to ".env" (same folder) and fill in the password:
#     Copy-Item .env.example .env
# docker compose reads .env automatically and passes these values to the containers.
# ".env" is in .gitignore, so the password is never committed.

# The read-only SQL Server login created in SSMS (CREATE LOGIN lusitania_etl ...)
SQL_USER=lusitania_etl
SQL_PASSWORD=
